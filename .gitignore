*.onnx
*.onnx.data
*.pth
*.pt
*.safetensors
# Root only: packages have their own data/ folders (scanlake_core/domain/data) that belong in git
/data/
/runs/
/out/

# Golden fixtures are committed on purpose; scratch captures are not
snapshots/
debug_*/

# Local secrets
.env
.env.*
!.env.example

# Packaging
.venv-ort/
build/
dist/
